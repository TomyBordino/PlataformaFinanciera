# Copiá este archivo a .env y completá tus keys (NUNCA subas .env a GitHub)
FINNHUB_KEY=tu_key_de_finnhub
ALPHAVANTAGE_KEY=tu_key_de_alpha_vantage
# Key de la API de Claude (console.anthropic.com) — habilita /api/ai/complete.
# Sin esta key, el análisis con IA del frontend no funciona (fuera de Claude Design).
ANTHROPIC_API_KEY=tu_key_de_anthropic
# Modelo a usar para el análisis IA (opcional, este es el default)
ANTHROPIC_MODEL=claude-opus-5
# Límite de pedidos de IA por IP y por hora — la plataforma no tiene login,
# así que este endpoint queda abierto; este tope evita un consumo descontrolado.
AI_RATE_LIMIT_PER_HOUR=30
# Secreto para firmar tokens de sesión (cualquier string largo y aleatorio)
SECRET=cambiame-por-un-string-aleatorio-largo
# Ruta de la base SQLite (en Render/Railway montá un disco persistente aquí)
DB_PATH=finterm.db
